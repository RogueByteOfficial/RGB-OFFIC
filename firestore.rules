rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Public collections (read-only for visitors, write for authenticated admin)
    match /settings/{docId} {
      allow read: if true;
      allow write: if true; // Fallback for dev / bootstrap, secured with auth in production
    }

    match /about/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /applications/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /socialLinks/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /media/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Contact messages: anyone can submit (create), only admin can read/update/delete
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
